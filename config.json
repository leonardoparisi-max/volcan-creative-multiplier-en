{
  "input_dir": "./input",
  "output_dir": "./output",
  "bin": {
    "ffmpeg": "/opt/homebrew/bin/ffmpeg",
    "ffprobe": "/opt/homebrew/bin/ffprobe",
    "whisper": "/opt/homebrew/bin/whisper-cli"
  },
  "whisper": {
    "model_path": "./models/ggml-large-v3-turbo.bin",
    "language": "en",
    "threads": 8
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "encoder": "h264_videotoolbox",
    "bitrate_final": "10M",
    "crf_master": 16
  },
  "audio": {
    "loudnorm_target_i": -14,
    "loudnorm_target_tp": -1.5,
    "loudnorm_target_lra": 11,
    "denoise": true,
    "denoise_strength": 0.12
  },
  "trim": {
    "auto_trim_silence": true,
    "silence_threshold_db": -35,
    "silence_min_duration": 0.25,
    "padding_start": 0.05,
    "padding_end": 0.1
  },
  "transicao": {
    "tipo": "fade",
    "duracao": 0.2,
    "abertura": "none",
    "abertura_duracao": 0.3,
    "fechamento": "fadeblack",
    "fechamento_duracao": 0.4
  },
  "legenda": {
    "fonte": "Montserrat ExtraBold",
    "tamanho": 96,
    "cor": "#FFFFFF",
    "cor_destaque": "#FFD400",
    "contorno_cor": "#000000",
    "contorno_largura": 6,
    "sombra": 2,
    "posicao_vertical": 0.6,
    "max_palavras_linha": 3,
    "modo": "karaoke_palavra"
  },
  "overlay_hook": {
    "fonte": "Montserrat ExtraBold",
    "tamanho": 84,
    "cor": "#FFFFFF",
    "contorno_cor": "#000000",
    "contorno_largura": 5,
    "posicao_vertical": 0.3,
    "alinhamento": "center",
    "fundo_caixa": false,
    "fundo_cor": "#000000AA",
    "animacao_entrada": "none"
  },
  "tarja": {
    "cor_inicio": "#D9443C",
    "cor_fim": "#F08B33",
    "fonte": "Montserrat ExtraBold",
    "tamanho": 82,
    "cor_texto": "#FFFFFF",
    "padding_vertical": 34,
    "espaco_linha": 8,
    "largura": 1,
    "sombra_offset": 4,
    "sombra_cor": "#00000055",
    "contorno_largura": 0,
    "contorno_cor": "#000000",
    "posicao_vertical": 0.66
  },
  "layout": {
    "divisao_padrao": 0.55,
    "foco_video_padrao": 0.5,
    "foco_imagem_padrao": 0.5
  },
  "edicao": {
    "punch_in": {
      "ativo": true,
      "zoom": 1.08,
      "a_cada": "frase",
      "segundos": 4
    }
  },
  "render": {
    "concorrencia": 4,
    "sobrescrever_existentes": false,
    "padrao_nome": "{hook}_{body}_{cta}",
    "prefixo": "",
    "arquivos_unicos": true,
    "leva_atual": ""
  }
}
